{
  "manifestVersion": 5,
  "id": "com.yourname.premiere.mcp.bridge",
  "name": "MCP Bridge",
  "version": "1.0.0",
  "main": "src/index.js",
  "host": {
    "app": "premierepro",
    "minVersion": "25.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "mcpBridgePanel",
      "label": {
        "default": "MCP Bridge"
      },
      "minimumSize": {
        "width": 360,
        "height": 240
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 360
      },
      "preferredFloatingSize": {
        "width": 520,
        "height": 420
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "filesystem": "all"
  }
}
