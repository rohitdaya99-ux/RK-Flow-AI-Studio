.app-shell{
display:flex;
font-size:var(--font-md);
width:100%;
height:100vh;
overflow:hidden;
background:#0b0d12;
color:#fff;
}

.app-main{
flex:1;
display:flex;
flex-direction:column;
min-width:0;
height:100vh;
overflow:hidden;
}

.workspace{
flex:1;
display:flex;
min-height:0;
overflow:hidden;
}

.workspace-main{
flex:1;
min-width:0;
overflow-y:auto;
overflow-x:hidden;
padding:28px;
background:#0f1117;
}

.workspace-ai{
width:var(--copilot-width);
min-width:var(--copilot-width);
max-width:var(--copilot-width);
border-left:1px solid rgba(255,255,255,.08);
background:#15181f;
overflow:hidden;
display:flex;
}

.workspace-ai>*{
flex:1;
}

.status-bar{
height:42px;
flex-shrink:0;
}
